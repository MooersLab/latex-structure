@tab On a heading line
@tab In a list item
@item @code{M-<up>}
@tab Move section up
@tab Move item up
@item @code{M-<down>}
@tab Move section down
@tab Move item down
@item @code{M-<left>}
@tab Promote heading line
@tab Outdent item
@item @code{M-<right>}
@tab Demote heading line
@tab Indent item
@item @code{M-S-<left>}
@tab Promote whole section
@tab Outdent item
@item @code{M-S-<right>}
@tab Demote whole section
@tab Indent item
@item @code{C-c -}
@tab Not active
@tab Cycle the list type
@end multitable
@caption{Key bindings of latex-structure-mode.}
@end float

@float Table,org312dbee
@multitable {aaaaaaaaaaaaa} {aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa}
@headitem Key
@tab Command
@item @code{C-c C-w}
@tab @code{latex-structure-refile}
@item @code{C-u C-c C-w}
@tab Jump to a heading, like @code{latex-structure-goto}
@item @code{C-c M-w}
@tab @code{latex-structure-refile-copy}
@item @code{C-c C-x b}
@tab @code{latex-structure-tree-to-indirect-buffer}
