;;; build-api.el --- Write the API reference for latex-structure -*- lexical-binding: t; -*-

;; Copyright (C) 2026 Blaine Mooers

;; This file is not part of GNU Emacs.

;;; Commentary:

;; Used by `make docs-api'.  Load the package and write a Markdown API
;; reference built from the docstrings, so that the reference never
;; drifts from the code.  The output groups the symbols into the minor
;; mode, user options, commands, public functions, and internal
;; helpers.  Each command lists its default key bindings and speed
;; keys.

;;; Code:

(require 'cl-lib)
(require 'subr-x)
(require 'lisp-mnt)
(require 'latex-structure)

(defun lst-docs--symbols ()
  "Return the functions and variables defined by the package, sorted."
  (let ((entry (cl-find-if (lambda (e)
                             (and (stringp (car e))
                                  (string-match-p "latex-structure\\.elc?\\'"
                                                  (car e))))
                           load-history))
        fns vars)
    (dolist (item (cdr entry))
      (cond ((and (consp item) (eq (car item) 'defun)) (push (cdr item) fns))
            ((symbolp item) (push item vars))))
    (cons (sort fns #'string<) (sort vars #'string<))))

(defun lst-docs--binding-command (binding)
  "Return the command of BINDING, looking inside a menu-item."
  (if (eq (car-safe binding) 'menu-item) (nth 2 binding) binding))

(defun lst-docs--map-keys (map sym &optional prefix)
  "Return the key descriptions in MAP, under PREFIX, that run SYM."
  (let (out)
    (map-keymap
     (lambda (event binding)
       (let ((key (vconcat prefix (vector event))))
         (if (keymapp binding)
             (setq out (append out (lst-docs--map-keys binding sym key)))
           (when (eq (lst-docs--binding-command binding) sym)
             (push (key-description key) out)))))
     map)
    out))

(defun lst-docs--speed-keys (sym)
  "Return the default speed keys that run SYM, as a list of strings."
  (let (out)
    (dolist (spec (list (cons "heading" 'latex-structure-speed-commands)
                        (cons "`\\item`" 'latex-structure-item-speed-commands)))
      (dolist (e (eval (car (get (cdr spec) 'standard-value)) t))
        (when (eq (cdr-safe e) sym)
          (push (format "`%s` on %s lines" (car e) (car spec)) out))))
    (nreverse out)))

(defun lst-docs--keys (sym)
  "Return a sentence about the default keys that run SYM, or nil."
  (let ((map-keys (lst-docs--map-keys latex-structure-mode-map sym))
        (speed (lst-docs--speed-keys sym))
        parts)
    (when map-keys
      (push (format "Key in `latex-structure-mode`: %s."
                    (mapconcat (lambda (k) (format "`%s`" k)) map-keys ", "))
            parts))
    (when speed
      (push (format "Speed keys after `latex-structure-speed-commands-setup`: %s."
                    (string-join speed ", "))
            parts))
    (when parts (string-join (nreverse parts) "  "))))

(defun lst-docs--signature (fn)
  "Return the call signature of FN as a string."
  (let ((args (help-function-arglist fn t)))
    (format "(%s%s)" fn
            (if (and args (listp args))
                (concat " " (mapconcat (lambda (a) (upcase (symbol-name a)))
                                       args " "))
              ""))))

(defun lst-docs--doc (text)
  "Return docstring TEXT as a Markdown code block."
  (concat "```text\n" (string-trim-right (or text "Not documented.")) "\n```\n"))

(defun lst-docs-write-api (file)
  "Write the Markdown API reference to FILE."
  (let* ((syms (lst-docs--symbols))
         (fns (car syms))
         (vars (cdr syms))
         (options (cl-remove-if-not #'custom-variable-p vars))
         (other-vars (cl-remove-if
                      (lambda (v) (or (custom-variable-p v) (facep v)))
                      vars))
         (mode 'latex-structure-mode)
         (commands (cl-remove-if-not
                    (lambda (f) (and (commandp f) (not (eq f mode))))
                    fns))
         (internal (cl-remove-if-not
                    (lambda (f) (string-match-p "--" (symbol-name f))) fns))
         (public (cl-remove-if
                  (lambda (f) (or (commandp f) (memq f internal))) fns)))
    (with-temp-file file
      (insert "# latex-structure API reference\n\n"
              "This file is generated by `make docs-api` from the docstrings in\n"
              "`latex-structure.el`.  Do not edit it by hand.\n\n"
              (format "Version %s.\n\n" (or (ignore-errors
                                              (with-temp-buffer
                                                (insert-file-contents
                                                 (locate-library "latex-structure.el"))
                                                (lm-version)))
                                            "unknown")))
      (insert "## Minor mode\n\n### " (lst-docs--signature mode) "\n\n"
              (lst-docs--doc (documentation mode t)) "\n")
      (insert "## User options\n\n")
      (dolist (v options)
        (insert (format "### %s\n\n" v)
                (lst-docs--doc (documentation-property v 'variable-documentation t))
                "\n"))
      (insert "## Faces\n\n")
      (dolist (face (cl-remove-if-not #'facep vars))
        (insert (format "### %s\n\n" face)
                (lst-docs--doc (face-documentation face)) "\n"))
      (insert "## Commands\n\n")
      (dolist (f commands)
        (let ((keys (lst-docs--keys f)))
          (insert "### " (lst-docs--signature f) "\n\n"
                  (if keys (concat keys "\n\n") "")
                  (lst-docs--doc (documentation f t)) "\n")))
      (insert "## Functions\n\n")
      (dolist (f public)
        (insert "### " (lst-docs--signature f) "\n\n"
                (lst-docs--doc (documentation f t)) "\n"))
      (insert "## Internal functions and variables\n\n"
              "These may change without notice.\n\n"
              "| Symbol | Summary |\n|:--|:--|\n")
      (dolist (s (append internal other-vars))
        (let ((doc (if (fboundp s) (documentation s t)
                     (documentation-property s 'variable-documentation t))))
          (insert (format "| `%s` | %s |\n" s
                          (replace-regexp-in-string
                           "|" "\\\\|" (car (split-string (or doc "") "\n"))))))))
    (message "Wrote %s" file)))

(provide 'build-api)
;;; build-api.el ends here
